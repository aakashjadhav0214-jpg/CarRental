# Production Backend Configuration
SECRET_KEY=generate_a_random_secure_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite or PostgreSQL URL
# For production PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./rental.db

# Razorpay Keys (Get Live Keys from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Initial Admin Setup
ADMIN_EMAIL=admin@transrentals.in
ADMIN_PASSWORD=change_this_secure_password
ADMIN_PHONE=9110614141
ADMIN_NAME=Admin
